{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "dist",
    "proxy.ts",
    "lib/requestLog.ts",
    "tests/crawlPolicy.test.tsx",
    "tests/host/customerHostRemoval.test.ts",
    "tests/host/hostRouter.test.ts",
    "tests/host/readPagesMoveGate.test.tsx",
    "tests/host/retiredHostGate.test.ts",
    "tests/host/storySeams.test.tsx",
    "tests/i18n/detectionMatrix.test.tsx",
    "tests/i18n/routing.test.ts",
    "tests/i18n/zhTwStoryGate.test.ts",
    "tests/legal/bindingEnglishNoteGate.test.tsx"
  ]
}
