    "tests/host/retiredHostGate.test.ts",
    "tests/host/storySeams.test.tsx",
    "tests/i18n/detectionMatrix.test.tsx",
    "tests/i18n/routing.test.ts",
    "tests/i18n/zhTwStoryGate.test.ts",
    "tests/legal/bindingEnglishNoteGate.test.tsx",
    "app/[locale]/p",
    "app/[locale]/explore",
    "app/[locale]/ideas",
    "app/[locale]/motir-builds-itself",
    "app/sitemap-projects.xml",
    "lib/requestPublicHost.ts",
    "lib/explore.ts",
    "lib/publicProject.ts",
    "lib/sitemapEntries.ts",
    "tests/helpers/sitemap.ts",
