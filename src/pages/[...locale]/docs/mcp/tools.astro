---
/*
 * The MCP tool reference, generated from the tool catalogue read once per locale URL per build. Built once per locale
 * (MOTIR-10645) in the docs shell, rendered through the shared layout.
 */
import McpToolsRoute, {
  generateMetadata,
} from '@/app/[locale]/docs/(guides)/mcp/tools/McpToolsRoute'
import DocsLayout, {
  generateMetadata as docsMetadata,
} from '@/app/[locale]/docs/DocsLayout'
import DocsGuidesLayout from '@/app/[locale]/docs/(guides)/DocsGuidesLayout'
import SitePage from '@/src/layouts/SitePage.astro'
import { localeStaticPaths, pageLocale } from '@/lib/staticPaths'

export const getStaticPaths = localeStaticPaths
---

<SitePage
  locale={pageLocale(Astro.params)}
  page={McpToolsRoute}
  layouts={[DocsLayout, DocsGuidesLayout]}
  metadata={[docsMetadata, generateMetadata]}
/>
