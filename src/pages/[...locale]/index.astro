---
/*
 * The landing, `/` and `/<locale>`. Built once per locale (MOTIR-10644); the page module is the
 * Next route's, rendered through the shared layout.
 */
import LandingRoute, { generateMetadata } from '@/app/[locale]/LandingRoute'
import SitePage from '@/src/layouts/SitePage.astro'
import { localeStaticPaths, pageLocale } from '@/lib/staticPaths'

export const getStaticPaths = localeStaticPaths
---

<SitePage
  locale={pageLocale(Astro.params)}
  page={LandingRoute}
  metadata={[generateMetadata]}
/>
