---
/*
 * THE DOCUMENT EVERY BUILT motir.co PAGE IS (MOTIR-10643).
 *
 * One layout writes every page's `<html>`: the locale's `<html lang>`, the
 * site's one look as attributes on the first byte (MOTIR-7724), the head the
 * page module's metadata stands for (`lib/metadata.ts`, in the Next build's
 * order), and ONE React root in `<body>` (`lib/pageRoot.tsx`) holding the
 * page, its route layouts and the site body. The islands inside it hydrate
 * from the context block this layout writes (`lib/island.tsx`).
 *
 * A page states its locale, its page module and its metadata functions — the
 * site's layer is always first — and nothing else.
 */
import '@/app/globals.css'
import '@/app/fonts.css'
import { SITE_HTML_CLASS } from '@/app/_components/SiteDocument'
import { FONT_PRELOADS } from '@/app/fontPreloads'
import { siteMetadata } from '@/app/_components/siteMetadata'
import { LOCALE_BCP47, type Locale } from '@/i18n/routing'
import { localeParams } from '@/i18n/locale'
import { clientCopy, getCopy } from '@/lib/copy'
import { PAGE_CONTEXT_ID } from '@/lib/islands'
import { headTags, resolveMetadata, type Metadata } from '@/lib/metadata'
import {
  PageRoot,
  type LayoutComponent,
  type PageComponent,
} from '@/lib/pageRoot'
import { serializeJsonForScript } from '@/lib/scriptJson'
import { servedPathname } from '@/lib/staticPaths'
import {
  clearStoredAppearanceScript,
  siteAppearanceAttributes,
} from '@/lib/siteDefaults'

type Params = { locale: string } & Record<string, string>
type MetadataLayer = (props: {
  params: Promise<Params>
}) => Metadata | Promise<Metadata>

interface Props {
  locale: Locale
  /** The page module's default export. */
  page: PageComponent<Params>
  /** The route's layouts under Next, outermost first. */
  layouts?: ReadonlyArray<LayoutComponent<Params>>
  /** The page's other route params (`slug`), beside its locale. */
  params?: Record<string, string>
  /** The route's `generateMetadata` functions, outermost first. */
  metadata?: ReadonlyArray<MetadataLayer>
  /** Metadata keys fixed by the route itself (a not-found room's `robots`). */
  extraMetadata?: Metadata
  /** Built once, served at every unknown address (the not-found room). */
  servedAtAnyPath?: boolean
}

const {
  locale,
  page,
  layouts = [],
  params: extra = {},
  metadata = [],
  extraMetadata,
  servedAtAnyPath = false,
} = Astro.props
const params = localeParams(locale, extra) as Promise<Params>
const copy = await getCopy(locale)
const head = resolveMetadata(
  siteMetadata(locale, copy),
  ...(await Promise.all(metadata.map((layer) => layer({ params })))),
  extraMetadata,
)
const value = {
  locale,
  copy,
  pathname: servedPathname(Astro.url.pathname),
  servedAtAnyPath,
}
const pageContext = serializeJsonForScript({
  ...value,
  copy: clientCopy(copy),
})
---

<!doctype html>
<html
  lang={LOCALE_BCP47[locale]}
  class={SITE_HTML_CLASS}
  {...siteAppearanceAttributes}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {FONT_PRELOADS.map((href) => (
      <link
        rel="preload"
        href={href}
        as="font"
        type="font/woff2"
        crossorigin=""
      />
    ))}
    <Fragment set:html={headTags(head).join('')} />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" sizes="any" />
    <link
      rel="apple-touch-icon"
      href="/apple-icon.png"
      type="image/png"
      sizes="180x180"
    />
    <script is:inline set:html={clearStoredAppearanceScript} />
  </head>
  <body>
    <PageRoot value={value} page={page} layouts={layouts} params={params} />
    <script
      type="application/json"
      id={PAGE_CONTEXT_ID}
      is:inline
      set:html={pageContext}
    />
    <script>
      import '@/src/scripts/hydrateIslands'
    </script>
  </body>
</html>
