/*
 * motir.co ON CLOUDFLARE WORKERS (MOTIR-10634 · MOTIR-10643 · MOTIR-10635).
 *
 * The static half of the site is `astro build`'s `dist/`, served as Workers
 * static assets: a request for a built page runs no code. A Worker script
 * (`worker/index.ts`) sits in front of the assets for the live public
 * surface only, rendering it per request.
 *
 *  • `html_handling: "auto-trailing-slash"` (the default, written down)
 *    serves `price.html` at `/price` and `de.html` at `/de`, the unslashed
 *    addresses every canonical names (`astro.config.mjs`, `build.format`).
 *  • `not_found_handling: "none"`, and the WORKER answers a path with no file
 *    with the locale's built 404 room and a 404 status — `de/404.html` for a
 *    mistyped `/de/…`, `404.html` for the rest (`notFoundPage` in
 *    `worker/notFound.ts`), which is what `"404-page"` did while the site
 *    had no Worker.
 *    ⚠️ WHY NOT `"404-page"` ANY MORE: with it set, Cloudflare serves the
 *    404 page for an unmatched path WITHOUT invoking the Worker (measured
 *    under `wrangler dev`, for a navigation and for a plain request alike),
 *    so a mis-cased locale (`/zh-TW/price`) could never get its 308 to the
 *    lower-case spelling. With `"none"`, a request no file matches invokes
 *    the Worker, as the static-assets documentation states.
 *  • `_redirects`, which the build writes from `lib/redirects.ts`, carries
 *    the `/en` → `/` 308s and the `/products/*` → docs 308s.
 *
 * ── WHEN THE WORKER RUNS ───────────────────────────────────────────────────
 *
 *  • `run_worker_first` names the live surface in every locale (`/p/*`,
 *    `/explore`, `/explore/topic/*`, `/ideas`, `/motir-builds-itself`), the
 *    same addresses under the English prefix (answered with a 308), the
 *    project sitemap and the bare `/`, where the first visit's language is
 *    chosen. Generated by `worker/routes.ts` (`RUN_WORKER_FIRST`) and held to
 *    the registered page set by `tests/worker/runWorkerFirst.test.ts`, so no
 *    built page is ever pulled onto the Worker. At most 100 entries.
 *  • Any other request no file matches also invokes it — a mis-cased locale
 *    (`/zh-TW/price`) is answered with a 308 that way, and the rest with the
 *    localized 404. `_redirects` still answers first.
 *
 * ── THE RUNTIME VARIABLES ──────────────────────────────────────────────────
 *
 * `MOTIR_APP_ORIGIN` (the public API the live pages read, and the app's
 * doors) and `MOTIR_SITE_ORIGIN` (canonicals and the sitemap) are read at
 * request time, so one built Worker is pointed at the e2e stub with
 * `wrangler dev --var` and at production by the values below, which are what
 * `ci.yml`'s `deploy` job ships (MOTIR-10637): app.motir.co and motir.co.
 *
 * ── HOW IT IS RELEASED ─────────────────────────────────────────────────────
 *
 * `ci.yml`'s `Deploy to Cloudflare` job runs `wrangler deploy` with this file
 * on `main`, behind every gate (MOTIR-10637). There are no `routes` here yet:
 * attaching motir.co and www is the cut's (MOTIR-10638). `workers_dev` keeps
 * the Worker's own `*.workers.dev` address on, which is where the deploy
 * job's smoke step reads the release before the cut, and after it; every page
 * names motir.co as its canonical, so that copy is never indexed as the site.
 * `pnpm start` serves the build and the Worker locally through `wrangler dev`.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motir-marketing",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/",
      "/sitemap-projects.xml",
      "/p/*",
      "/explore",
      "/explore/topic/*",
      "/ideas",
      "/motir-builds-itself",
      "/zh/p/*",
      "/zh/explore",
      "/zh/explore/topic/*",
      "/zh/ideas",
      "/zh/motir-builds-itself",
      "/zh-tw/p/*",
      "/zh-tw/explore",
      "/zh-tw/explore/topic/*",
      "/zh-tw/ideas",
      "/zh-tw/motir-builds-itself",
      "/ja/p/*",
      "/ja/explore",
      "/ja/explore/topic/*",
      "/ja/ideas",
      "/ja/motir-builds-itself",
      "/ko/p/*",
      "/ko/explore",
      "/ko/explore/topic/*",
      "/ko/ideas",
      "/ko/motir-builds-itself",
      "/de/p/*",
      "/de/explore",
      "/de/explore/topic/*",
      "/de/ideas",
      "/de/motir-builds-itself",
      "/fr/p/*",
      "/fr/explore",
      "/fr/explore/topic/*",
      "/fr/ideas",
      "/fr/motir-builds-itself",
      "/es/p/*",
      "/es/explore",
      "/es/explore/topic/*",
      "/es/ideas",
      "/es/motir-builds-itself",
      "/it/p/*",
      "/it/explore",
      "/it/explore/topic/*",
      "/it/ideas",
      "/it/motir-builds-itself",
      "/nl/p/*",
      "/nl/explore",
      "/nl/explore/topic/*",
      "/nl/ideas",
      "/nl/motir-builds-itself",
      "/pl/p/*",
      "/pl/explore",
      "/pl/explore/topic/*",
      "/pl/ideas",
      "/pl/motir-builds-itself",
      "/pt/p/*",
      "/pt/explore",
      "/pt/explore/topic/*",
      "/pt/ideas",
      "/pt/motir-builds-itself",
      "/en/p/*",
      "/en/explore",
      "/en/explore/topic/*",
      "/en/ideas",
      "/en/motir-builds-itself",
    ],
  },
  "vars": {
    "MOTIR_APP_ORIGIN": "https://app.motir.co",
    "MOTIR_SITE_ORIGIN": "https://motir.co",
  },
}
