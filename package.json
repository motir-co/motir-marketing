{
  "name": "motir-marketing",
  "version": "0.0.0",
  "private": true,
  "description": "The Motir marketing site — motir.co. GPL-3.0.",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "astro dev",
    "build": "SKILLS_RELEASE_TAG=$(node scripts/skills/resolve-release.ts) astro build",
    "start": "wrangler dev",
    "lint": "eslint",
    "typecheck": "astro sync && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:design": "vitest run --config vitest.design.config.mts",
    "test:e2e": "playwright test",
    "test:seam": "vitest run --config vitest.seam.config.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "brand:icons": "node scripts/brand/generate-brand-icons.ts",
    "brand:og-fonts": "node scripts/brand/subset-og-fonts.ts",
    "design:render": "node scripts/design/render-design-mock.ts",
    "docs:revisions": "node scripts/docs/revisions.ts",
    "i18n:extract": "node scripts/i18n/catalogue.ts extract",
    "i18n:merge": "node scripts/i18n/catalogue.ts merge",
    "i18n:status": "node scripts/i18n/catalogue.ts status",
    "i18n:baseline": "node scripts/i18n/catalogue.ts baseline",
    "i18n:glossary-sync": "node scripts/i18n/catalogue.ts glossary-sync",
    "i18n:check-static-pages": "node scripts/i18n/check-static-pages.ts",
    "parity:check": "node scripts/parity/check-parity.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@fontsource-variable/noto-sans-tc": "5.3.1",
    "@fontsource-variable/noto-serif-jp": "5.3.1",
    "@fontsource-variable/noto-serif-kr": "5.3.1",
    "@fontsource-variable/noto-serif-sc": "5.3.1",
    "@fontsource-variable/noto-serif-tc": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/lxgw-wenkai-tc": "5.3.1",
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@fontsource/nanum-gothic": "5.3.0",
    "@motir/brand": "0.4.4",
    "@motir/design-system": "0.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.7",
    "lucide-react": "^1.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "use-intl": "4.14.9"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^22.19.19",
    "@types/opentype.js": "1.3.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "jsonc-parser": "3.3.1",
    "opentype.js": "1.3.4",
    "playwright": "^1.62.1",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "1.1.2",
    "satori": "0.63.2",
    "sharp": "0.34.5",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.11",
    "wrangler": "4.158.0"
  },
  "type": "module"
}
